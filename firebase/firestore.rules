rules_version = '2';
// Regras do Xadrez · Rota do Mestre.
// Salas de partida ao vivo: qualquer pessoa com login anônimo pode ler uma sala (precisa saber o código),
// só o criador cria, só UMA pessoa entra como convidada e, depois disso, só os dois jogadores mexem na sala.
// Ninguém apaga nada pelo app (as salas antigas podem expirar pela política de TTL no campo "expira").
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function okSize(d) {
      return d.moves is list && d.moves.size() <= 700
        && d.hostName is string && d.hostName.size() <= 30
        && d.guestName is string && d.guestName.size() <= 30;
    }

    match /salas/{code} {
      allow read: if signedIn() && code.size() == 6;

      allow create: if signedIn() && code.size() == 6
        && request.resource.data.host == request.auth.uid
        && request.resource.data.guest == null
        && request.resource.data.status == 'wait'
        && request.resource.data.moves.size() == 0
        && request.resource.data.hostColor in ['w', 'b']
        && okSize(request.resource.data);

      // entrar como convidado: só enquanto a sala espera, e só estes campos
      allow update: if signedIn()
        && resource.data.status == 'wait' && resource.data.guest == null
        && request.auth.uid != resource.data.host
        && request.resource.data.guest == request.auth.uid
        && request.resource.data.status == 'play'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guest', 'guestName', 'guestElo', 'status'])
        && okSize(request.resource.data);

      // durante e depois da partida: só os dois jogadores, sem trocar quem é quem nem as cores
      allow update: if signedIn()
        && (request.auth.uid == resource.data.host || (resource.data.guest != null && request.auth.uid == resource.data.guest))
        && request.resource.data.host == resource.data.host
        && request.resource.data.guest == resource.data.guest
        && request.resource.data.hostColor == resource.data.hostColor
        && request.resource.data.tc == resource.data.tc
        && request.resource.data.moves.size() >= resource.data.moves.size()
        && request.resource.data.moves.size() <= resource.data.moves.size() + 1
        // um lance novo só pode vir de quem tem a vez
        && (request.resource.data.moves.size() == resource.data.moves.size()
            || (((resource.data.moves.size() % 2 == 0) == (resource.data.hostColor == 'w')) && request.auth.uid == resource.data.host)
            || (((resource.data.moves.size() % 2 == 0) != (resource.data.hostColor == 'w')) && request.auth.uid == resource.data.guest))
        && okSize(request.resource.data);

      allow delete: if false;

      // ---- extras da sala ----
      function sala() { return get(/databases/$(database)/documents/salas/$(code)).data; }
      function jogadorDe(c) { return sala().hostColor == c ? sala().host : sala().guest; }
      function ehJogador() { return signedIn() && (request.auth.uid == sala().host || request.auth.uid == sala().guest); }

      // telefone para a ligação pelo WhatsApp: cada jogador grava o próprio; só os dois jogadores leem; qualquer um deles apaga no fim
      match /privado/{cor} {
        allow read, delete: if ehJogador();
        allow create, update: if signedIn() && cor in ['w', 'b'] && request.auth.uid == jogadorDe(cor)
          && request.resource.data.keys().hasOnly(['tel', 't'])
          && request.resource.data.tel is string && request.resource.data.tel.matches('^[0-9]{10,15}$');
      }

      // Sinalização WebRTC de áudio: só os dois participantes autenticados.
      // Nenhuma gravação, número telefônico ou mídia é armazenada aqui.
      match /voz/{cor} {
        allow read: if ehJogador() && cor in ['w', 'b'];
        allow create, update: if ehJogador() && cor in ['w', 'b']
          && request.auth.uid == jogadorDe(cor)
          && request.resource.data.keys().hasOnly(['uid','enabled','sid','sdp','ice','t'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.enabled is bool
          && request.resource.data.sid is string
          && request.resource.data.sid.size() <= 80
          && request.resource.data.sdp is string
          && request.resource.data.sdp.size() <= 30000
          && request.resource.data.ice is list
          && request.resource.data.ice.size() <= 180
          && request.resource.data.t == request.time;
        allow delete: if false;
      }
      // quem está assistindo: cada um marca a própria presença
      match /plateia/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['t']) && request.resource.data.t == request.time;
        allow delete: if false;
      }
      // reações (emojis): jogadores pela própria cor, plateia como 'p'
      match /reacoes/{id} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['e', 'de', 't', 'uid'])
          && request.resource.data.e in ['👍', '😮', '😂', '👏', '🤝', '🔥']
          && request.resource.data.de in ['w', 'b', 'p']
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.t == request.time
          && (request.resource.data.de == 'p' || request.auth.uid == jogadorDe(request.resource.data.de));
        allow update, delete: if false;
      }
    }

    // conta Google: perfil e partidas na nuvem. Cada pessoa só lê e grava o que é dela (anônimos não usam a nuvem).
    function owner(uid) {
      return signedIn() && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    match /users/{uid} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && request.resource.data.d is string && request.resource.data.d.size() < 900000;
      match /games/{gid} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && request.resource.data.rec is string && request.resource.data.rec.size() < 60000;
      }
    }

    // caixa de sugestões: qualquer jogador ENVIA (com login anônimo ou Google); só a conta do criador LÊ, marca e apaga.
    // A lista abaixo tem o uid da conta Google do criador (não é senha: só identifica a conta).
    function criador() { return signedIn() && request.auth.uid in ['yQcB43kSJcbxnJorS1QsJsJtP5x1']; }
    match /sugestoes/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['tipo', 'msg', 'contato', 'versao', 'aparelho', 't', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tipo in ['ideia', 'erro', 'elogio', 'outro']
        && request.resource.data.msg is string && request.resource.data.msg.size() >= 3 && request.resource.data.msg.size() <= 1000
        && request.resource.data.contato is string && request.resource.data.contato.size() <= 80
        && request.resource.data.versao is string && request.resource.data.versao.size() <= 40
        && request.resource.data.aparelho is string && request.resource.data.aparelho.size() <= 60
        && request.resource.data.t == request.time;
      allow read, delete: if criador();
      allow update: if criador() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lida', 'guardada']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
